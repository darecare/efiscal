# Copy to .env on the QA server (cp .env.qa.example .env && chmod 600 .env) and fill in real values.
# Never commit .env.

# PostgreSQL (the backend datasource username/password are derived from these in docker-compose.qa.yml)
POSTGRES_DB=efiscal
POSTGRES_USER=efiscal
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Software identity shown on the About screen and sent to the Tax Authority
APP_MANUFACTURER=Elef
APP_SERIAL_NUMBER=ELEF-VPS-QA-001
APP_SOFTWARE_VERSION=1.1.0
APP_ESIR_NUMBER=1702

# Host ports (bound to 127.0.0.1 only). 8080 is already used on the QA VPS by another Java process.
# If you change these, update the ProxyPass ports in the Apache vhost as well.
EFISCAL_BACKEND_PORT=8090
EFISCAL_FRONTEND_PORT=8091

# Optional: backend JVM memory
# JAVA_TOOL_OPTIONS="-Xms256m -Xmx768m"

# Branch deployed by deploy/qa-deploy.sh
DEPLOY_BRANCH=main
